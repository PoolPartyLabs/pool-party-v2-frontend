# Pool Party v2 Frontend - PROD build-time env template.
# Copy to .env.prod (gitignored, stays local) and fill in the placeholders, then build with
# `sh scripts/push_image.sh prod`. Only NEXT_PUBLIC_* plus the Server Actions key live here:
# they are BAKED into the image at build time. Runtime server secrets (PP_API_URL, PP_API_KEY,
# ANALYTICS_API_URL, PP_ANALYTICS_USER_ID_SECRET) are NOT build-time and are injected on the
# prod host via the compose env_file.
# Source of truth: docs/_analysis/prod-release-playbook-2026-07-22.md, section 4 ("v2 frontend").

# Literal "false" or the mock app ships to prod (push_image.sh preflight enforces this).
NEXT_PUBLIC_MOCK_MODE=false

# Kill switch for NEXT_PUBLIC_FEATURE_ALL + dev panels; the easiest var to forget.
NEXT_PUBLIC_APP_ENV=production

# Public prod origin (scheme + host, no trailing slash). Must NOT be a dev host.
# Also listed in next.config.ts serverActions.allowedOrigins (CloudFront origin check).
NEXT_PUBLIC_APP_URL=https://v2.app.pool-party.xyz

NEXT_PUBLIC_CHAIN_ID=137

# Prod Privy app (playbook decision 1.3). Remember the off-repo step: add the v2 prod origin
# to the Privy app allowlist + WalletConnect project settings.
NEXT_PUBLIC_PRIVY_APP_ID=<prod-privy-app-id>

# PROD manager write contracts (public on-chain addresses, safe to commit).
NEXT_PUBLIC_ARBITRUM_POOL_PARTY_MANAGER_WRITE_CONTRACT=0x90b5F4D2aECA515D368BB73e4B3cD4155dCB42d3
NEXT_PUBLIC_BASE_POOL_PARTY_MANAGER_WRITE_CONTRACT=0xD6f2f4B4638f8783e2B7697454C6Bf292F25b54f
NEXT_PUBLIC_POLYGON_POOL_PARTY_MANAGER_WRITE_CONTRACT=0x1bAe2a257E2EF0DC72caC5A4fF3c05746273CFE0

# Prod is the first GTM-live env; verify the GA4 tag config inside the container before launch.
NEXT_PUBLIC_GTM_ID=<GTM-XXXXXXX>

# Server Actions encryption key (POO-673). Generate ONCE with `openssl rand -base64 32`, keep it
# STABLE across ALL prod builds forever (a new key rotates Server Action IDs and breaks stale
# browser tabs), and NEVER reuse the committed dev key from .env.example (preflight enforces this).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<openssl rand -base64 32>

# ---------------------------------------------------------------------------
# UNSET on purpose (per the prod release playbook) - do NOT add these here:
# - all NEXT_PUBLIC_FEATURE_* : registry defaults ARE the launch state (core + rewards on, rest off)
# - the 3 operation minimums (NEXT_PUBLIC_MIN_AMOUNT_FOR_ADD_LIQUIDITY / _CREATE_POOL /
#   NEXT_PUBLIC_MIN_COLLECT_USD): prod floors are the code defaults ($10 add / $20 create / $0.10 collect)
# - NEXT_PUBLIC_VIRTUALIZE_THRESHOLD (default 500)
# - NEXT_PUBLIC_SIWE_EIP4361 (backend companion POO-436 not live)
# NEXT_PUBLIC_FEATURE_STRATEGY_CATEGORY_FILTER: set on only if playbook decision 1.4 says yes.
# ---------------------------------------------------------------------------

# --- Deploy: image version --------------------------------------------------------------------
# IMAGE_VERSION is the immutable ECR tag scripts/push_image.sh pushes this prod image under (also
# :latest). The prod host pins it (INTERFACE_V2_TAG in the compose .env) and rolls back to a prior
# tag if a release breaks. Bump at least a patch every prod release (e.g. v1.0.0 -> v1.0.1).
IMAGE_VERSION=v1.0.0
