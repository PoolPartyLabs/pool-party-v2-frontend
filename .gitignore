# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# e2e (playwright) — artifacts only; the e2e/ source IS committed
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/
/.playwright/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Claude Code session transcript dumps (may contain secrets/context; never commit)
even-terminal-*.log

# env files (can opt-in for committing if needed)
.env*
# ...but the templates ARE committed (docs reference them; they hold no secrets).
!.env.example
!.env.prod.example

# vercel
.vercel

# storybook
/storybook-static

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch (throwaway implementation .md; never committed, deleted after use - see CLAUDE.md)
/_tmp/

# Claude Code local runtime. These were previously protected only by .git/info/exclude
# and a personal global gitignore, neither of which travels with the repo.
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/routines/.state/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local/
.claude/first-run
.claude/assistant-daemon-state.json

# Internal analyses and integration notes: not for the public repository.
/docs/_analysis/

# Any log file. Session transcripts leaked into git history once already.
*.log
