  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "config:check": "tsx scripts/config-check.ts",
    "secrets:check": "tsx scripts/bundle-secrets-check.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "aqua:ship": "tsx --conditions=react-server scripts/aqua/strategy.ts ship",
    "aqua:roll": "tsx --conditions=react-server scripts/aqua/strategy.ts roll",
    "aqua:dock": "tsx --conditions=react-server scripts/aqua/strategy.ts dock",
    "aqua:launch-payloads": "tsx --conditions=react-server scripts/aqua/strategy.ts launch-payloads",
    "aqua:discover": "tsx --conditions=react-server scripts/aqua/discover.ts"
